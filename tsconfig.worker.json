{
  "compilerOptions": {
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.worker.tsbuildinfo",
    "target": "ES2022",
    "lib": ["ES2022"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "skipLibCheck": true,
    "strict": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": true,
    // node: chi cho ha tang test cua worker (worker/src/test-support dung
    // node:sqlite/fs de chay adapter D1 tren SQLite that). Code worker that
    // van chay tren Cloudflare, khong duoc dung API node.
    "types": ["@cloudflare/workers-types", "node"]
  },
  "include": ["worker", "shared"]
}
